# Finture — variáveis do ambiente LOCAL (docker-compose.local.yaml).
#
# NÃO copie nada do .env.prod para cá. Este arquivo só guarda segredos locais,
# gerados aleatoriamente por `make setup` (ou `script/local-dev setup`), que cria
# o .env.local real (ignorado pelo Git).
#
# Hosts de banco, Redis, SMTP, storage e FRONTEND_URL NÃO ficam aqui: estão
# fixados no docker-compose.local.yaml e sobrescrevem qualquer valor deste
# arquivo. Credenciais produtivas (Azure Storage, AZURE_APP_*, SMTP_USERNAME/
# SMTP_PASSWORD, Meta/WhatsApp, OpenAI, Sentry...) fazem o Rails abortar o boot.

# Assinatura de cookies/sessões. Gerado localmente (openssl rand -hex 64).
SECRET_KEY_BASE=

# Senha do PostgreSQL local (usuário chatwoot_local). Gerado localmente.
POSTGRES_PASSWORD=

# Senha do Redis local. Gerado localmente.
REDIS_PASSWORD=

# Senha dos usuários fictícios criados pelas seeds Finture (admin@finture.example etc.).
# Padrão documentado; troque se quiser.
LOCAL_SEED_PASSWORD=Finture@Local2026

# Como o código chega ao container: sync | bind | vazio (automático).
# Automático = sync no Windows (Git Bash) e bind em WSL/Linux/macOS.
# sync: código num volume Linux + `docker compose watch` (rápido em pasta Windows/OneDrive).
# bind: bind mount direto (use quando o repositório estiver no filesystem do WSL).
LOCAL_CODE_MODE=

# Portas publicadas em 127.0.0.1 (opcional; mude se já estiverem em uso).
# Rails (3000) e Vite (3036) são fixas.
LOCAL_POSTGRES_PORT=5432
LOCAL_REDIS_PORT=6379
LOCAL_MAILPIT_PORT=8025
LOCAL_WEBHOOK_SINK_PORT=8099

# Liberação CONSCIENTE de hosts externos (ex.: sandbox autorizado), separados por
# vírgula. Vazio = nenhuma saída. Observação: Rails/Sidekiq rodam numa rede
# Docker sem internet; liberar aqui não basta, e isso é intencional.
LOCAL_EGRESS_ALLOWLIST=
